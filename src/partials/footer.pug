footer.site-footer
  .container.site-footer__inner
    p
      | © 
      span(data-year)= year
      |  #{name}. Santiago, Chile.
    nav(aria-label="Contacto")
      ul.cluster(role="list")
        li
          a(href=`mailto:${email}`)
            | Correo
            span.visually-hidden= ` ${email}`
        li
          +text-external(linkedin)
            | LinkedIn
        li
          +text-external(github)
            | GitHub
        li
          a(href=cvPath download=cvFilename) Descargar CV
