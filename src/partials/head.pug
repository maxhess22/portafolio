head
  meta(charset="utf-8")
  meta(name="viewport" content="width=device-width, initial-scale=1")
  meta(name="color-scheme" content="dark")
  meta(name="theme-color" content="#172c3f")
  script.
    document.documentElement.setAttribute("data-enhanced", "true");
    (function () {
      var key = "portafolio-scroll:" + location.pathname;
      function read() {
        try { return sessionStorage.getItem(key); } catch (error) { return null; }
      }
      function write(y) {
        try { sessionStorage.setItem(key, String(y)); } catch (error) {}
      }
      var nav = performance.getEntriesByType && performance.getEntriesByType("navigation")[0];
      var saved = read();
      var y = saved == null ? NaN : Number(saved);
      if (nav && nav.type === "reload" && y > 0) {
        var restore = function () { window.scrollTo(0, y); };
        document.addEventListener("DOMContentLoaded", restore);
        window.addEventListener("load", function () {
          restore();
          requestAnimationFrame(function () { requestAnimationFrame(restore); });
        });
      }
      var scheduled = false;
      addEventListener("scroll", function () {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(function () {
          scheduled = false;
          write(window.scrollY);
        });
      }, { passive: true });
      addEventListener("pagehide", function () { write(window.scrollY); });
    })();
  title= title
  meta(name="description" content=description)
  meta(name="author" content=name)
  meta(property="og:title" content=title)
  meta(property="og:description" content=description)
  meta(property="og:type" content="website")
  meta(property="og:locale" content="es_CL")
  meta(name="twitter:card" content="summary")
  link(rel="icon" href="/favicon.svg" type="image/svg+xml")
  link(rel="icon" href="/favicon.ico" sizes="16x16")
  link(rel="stylesheet" href="/css/global.css")
  if jsonLd
    script(type="application/ld+json")
      != jsonLd
